rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function accountExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function role() {
      return adminDoc().data.get('role', 'owner');
    }

    function isOwner() {
      return signedIn() &&
        request.auth.uid == 'CebhzopoNTX70krUuVqv7aELAew2';
    }

    function isAdmin() {
      return accountExists() && adminDoc().data.get('enabled', true) == true;
    }

    function isManager() {
      return isAdmin() && role() in ['owner', 'manager'];
    }

    function isStaff() {
      return isAdmin() && role() == 'staff';
    }

    function canPos() {
      return canStaff('pos');
    }

    function canOrders() {
      return canStaff('orders');
    }

    function canStaff(permission) {
      return isStaff() &&
        adminDoc().data.get('permissions', {}).get(permission, false) == true;
    }

    function canReadModule(module) {
      return (module == 'dashboard' && canStaff('dashboard')) ||
        (module == 'categories' &&
          (canStaff('categories') || canStaff('products'))) ||
        (module == 'clients' && canStaff('clients')) ||
        (module == 'branches' && canStaff('branches')) ||
        (module == 'entries' && canStaff('stock')) ||
        (module == 'finance' && canStaff('finance'));
    }

    function canWriteModule(module) {
      return (module == 'categories' && canStaff('categories')) ||
        (module == 'clients' && canStaff('clients')) ||
        (module == 'branches' && canStaff('branches')) ||
        (module == 'entries' && canStaff('stock'));
    }

    function validStaffModuleData(module, data) {
      return data is map &&
        ((module == 'categories' &&
          data.keys().hasOnly(['cats']) &&
          data.cats is list) ||
         (module == 'clients' &&
          data.keys().hasOnly(['clients']) &&
          data.clients is list) ||
         (module == 'branches' &&
          data.keys().hasOnly(['branches', 'branch']) &&
          data.branches is list &&
          data.branch is string) ||
         (module == 'entries' &&
          data.keys().hasOnly(['entries']) &&
          data.entries is list));
    }

    function validStaffPermissions(permissions) {
      return permissions is map &&
        permissions.keys().hasOnly([
          'dashboard', 'pos', 'orders', 'stock', 'reports', 'finance',
          'products', 'categories', 'clients', 'branches'
        ]) &&
        permissions.get('dashboard', false) is bool &&
        permissions.get('pos', false) is bool &&
        permissions.get('orders', false) is bool &&
        permissions.get('stock', false) is bool &&
        permissions.get('reports', false) is bool &&
        permissions.get('finance', false) is bool &&
        permissions.get('products', false) is bool &&
        permissions.get('categories', false) is bool &&
        permissions.get('clients', false) is bool &&
        permissions.get('branches', false) is bool;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function managesData(userId) {
      return signedIn() &&
        (request.auth.uid == userId ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            request.auth.uid == 'bl2RfPTMp5h7opLSoPQh5MgdpM72' &&
            isManager()));
    }

    function staffUid(uid) {
      return uid in [
        'xuVZvF01nxaRoeW6CNaGSJM0XOr2',
        'OoTb1PYzrreBF57Ci4ZvfoMhtCg2'
      ];
    }

    function staffEmail(uid) {
      return uid == 'xuVZvF01nxaRoeW6CNaGSJM0XOr2'
        ? 'qsucely786@gmail.com'
        : 'cuyaneimi@gmail.com';
    }

    function validStaffRecord(uid) {
      return staffUid(uid) &&
        request.resource.data.keys().hasOnly([
          'role', 'email', 'displayName', 'enabled', 'permissions', 'updatedAt'
        ]) &&
        request.resource.data.role == 'staff' &&
        request.resource.data.email == staffEmail(uid) &&
        request.resource.data.enabled is bool &&
        validStaffPermissions(request.resource.data.permissions);
    }

    function validProduct(product) {
      return product is map &&
        product.keys().hasOnly([
          'code', 'name', 'img', 'cat', 'brand', 'size', 'color',
          'price', 'cost', 'stock'
        ]) &&
        product.get('code', '') is string &&
        product.get('name', '') is string &&
        product.get('price', -1) is number &&
        product.get('price', -1) >= 0 &&
        product.get('cost', -1) is number &&
        product.get('cost', -1) >= 0 &&
        product.get('stock', -1) is int &&
        product.get('stock', -1) >= 0;
    }

    function validPublicProduct(product) {
      return product is map &&
        product.keys().hasOnly([
          'code', 'name', 'img', 'cat', 'brand', 'size', 'color',
          'price', 'stock'
        ]) &&
        product.get('code', '') is string &&
        product.get('name', '') is string &&
        product.get('price', -1) is number &&
        product.get('price', -1) >= 0 &&
        product.get('stock', -1) is int &&
        product.get('stock', -1) >= 0;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isManager());
      allow list: if isManager();
      allow create: if isOwner() ||
        (isManager() && validStaffRecord(uid));
      allow update: if isOwner() ||
        (isManager() &&
          staffUid(uid) &&
          changedOnly(['role', 'email', 'displayName', 'enabled', 'permissions', 'updatedAt']) &&
          validStaffRecord(uid));
      allow delete: if isOwner();
    }

    match /products/{productId} {
      allow read: if isManager() || canStaff('products');
      allow create, delete: if isManager();
      allow update: if isManager() ||
        (canPos() &&
          changedOnly(['stock']) &&
          request.resource.data.stock is int &&
          request.resource.data.stock >= 0 &&
          request.resource.data.stock < resource.data.stock);
    }

    match /stockMovements/{id} {
      allow read: if isManager();
      allow create: if isManager() ||
        (canPos() &&
          request.resource.data.delta is int &&
          request.resource.data.delta < 0 &&
          request.resource.data.keys().hasOnly([
            'productId', 'sku', 'delta', 'stockAfter', 'by', 'note',
            'unitCodes', 'at'
          ]));
      allow update, delete: if false;
    }

    match /inventoryUnits/{unitId} {
      allow read: if isManager() || canPos();
      allow create: if isManager() &&
        request.resource.data.productId is string &&
        request.resource.data.code is string &&
        request.resource.data.status in ['available', 'sold'];
      allow update: if isManager() ||
        (canPos() &&
          resource.data.status == 'available' &&
          request.resource.data.status == 'sold' &&
          changedOnly(['status', 'soldAt', 'soldBy', 'orderCode']) &&
          request.resource.data.productId == resource.data.productId &&
          request.resource.data.code == resource.data.code);
      allow delete: if isManager();
    }

    match /orders/{orderId} {
      allow read: if isManager() || canOrders();
      allow create: if (isManager() || canOrders()) &&
        request.resource.data.customer is string &&
        request.resource.data.customer.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total > 0 &&
        request.resource.data.status == 'Pedido recibido';
      allow update: if (isManager() &&
          request.resource.data.status in [
            'Pedido recibido', 'En preparación', 'Empacado', 'En ruta',
            'Entregado', 'Cancelado'
          ] &&
          (changedOnly(['status', 'phone']) ||
            changedOnly(['status', 'phone', 'items', 'total', 'totalEdited',
                         'customer', 'notes']))) ||
        (canOrders() &&
          request.resource.data.status in [
            'Pedido recibido', 'En preparación', 'Empacado', 'En ruta',
            'Entregado', 'Cancelado'
          ] &&
          changedOnly(['status', 'phone']));
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read, create, update: if isManager();
      allow delete: if isManager();
    }

    match /conversations/{conversationId} {
      allow read, create, update: if isManager();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isManager();
        allow create: if isManager() &&
          request.resource.data.from == 'admin' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }

    match /settings/{doc} {
      allow read, write: if isManager();
    }

    match /facturasUsers/{userId}/posProducts/{productId} {
      allow read: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
          (canPos() || canStaff('stock') || canStaff('dashboard')));
      allow create: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
          canStaff('products') &&
          request.resource.data.type == 'product' &&
          validPublicProduct(request.resource.data.data));
      allow delete: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
          canStaff('products') &&
          resource.data.type == 'product');
      allow update: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
          request.resource.data.type == 'product' &&
          request.resource.data.data is map &&
          resource.data.data is map &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']) &&
          ((canStaff('products') &&
            validPublicProduct(request.resource.data.data)) ||
           (request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['stock']) &&
            request.resource.data.data.stock is int &&
            request.resource.data.data.stock >= 0 &&
            ((canStaff('stock')) ||
             (canPos() && request.resource.data.data.stock < resource.data.data.stock)))));
    }

    match /facturasUsers/{userId}/posMeta/{metaId} {
      allow read: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' && canPos());
      allow create, delete: if managesData(userId);
      allow update: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
          metaId == 'current' &&
          request.resource.data.type == 'meta' &&
          request.resource.data.data is map &&
          resource.data.data is map &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']) &&
          ((canPos() &&
            request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['n', 'caja']) &&
            request.resource.data.data.n is int &&
            request.resource.data.data.n >= resource.data.data.n &&
            request.resource.data.data.caja is map) ||
           (canStaff('categories') &&
            request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['cats']) &&
            request.resource.data.data.cats is list) ||
           (canStaff('branches') &&
            request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['branch']) &&
            request.resource.data.data.branch is string)));
    }

    match /facturasUsers/{userId}/records/{recordId} {
      allow read: if managesData(userId) ||
        (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
          isStaff() &&
          ((resource.data.type == 'module' &&
            canReadModule(resource.data.module)) ||
           (resource.data.type == 'product' &&
            (canStaff('products') || canStaff('reports'))) ||
           (resource.data.type == 'invoice' &&
            ((canOrders() && resource.data.data.createdBy == request.auth.uid) ||
             canStaff('reports') || canStaff('finance') || canStaff('dashboard')))));

      allow create: if signedIn() &&
        (request.auth.uid == userId ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            request.auth.uid == 'bl2RfPTMp5h7opLSoPQh5MgdpM72' &&
            isManager()) ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            canPos() &&
            recordId.matches('sevenroses_v1_invoice_.*') &&
            request.resource.data.type == 'invoice' &&
            request.resource.data.data is map &&
            request.resource.data.data.createdBy == request.auth.uid &&
            request.resource.data.data.id is string &&
            request.resource.data.data.items is list &&
            request.resource.data.data.items.size() > 0 &&
            request.resource.data.data.total is number &&
            request.resource.data.data.total > 0) ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            canStaff('products') &&
            recordId.matches('sevenroses_v1_product_.*') &&
            request.resource.data.type == 'product' &&
            validProduct(request.resource.data.data)));

      allow update: if signedIn() &&
        (request.auth.uid == userId ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            request.auth.uid == 'bl2RfPTMp5h7opLSoPQh5MgdpM72' &&
            isManager()) ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            request.resource.data.type == 'product' &&
            request.resource.data.data is map &&
            resource.data.data is map &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']) &&
            ((canStaff('products') && validProduct(request.resource.data.data)) ||
             (request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['stock']) &&
              request.resource.data.data.stock is int &&
              request.resource.data.data.stock >= 0 &&
              ((canStaff('stock')) ||
               (canPos() && request.resource.data.data.stock < resource.data.data.stock))))) ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            canPos() &&
            recordId == 'sevenroses_v1_meta' &&
            request.resource.data.data is map &&
            resource.data.data is map &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']) &&
            request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['n', 'caja']) &&
            request.resource.data.data.n is int &&
            request.resource.data.data.n >= resource.data.data.n &&
            request.resource.data.data.caja is map) ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            resource.data.type == 'module' &&
            canWriteModule(resource.data.module) &&
            request.resource.data.type == 'module' &&
            request.resource.data.module == resource.data.module &&
            validStaffModuleData(resource.data.module, request.resource.data.data) &&
            request.resource.data.keys().hasOnly(['type', 'module', 'data']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data'])));

      allow delete: if signedIn() &&
        (managesData(userId) ||
          (userId == 'CebhzopoNTX70krUuVqv7aELAew2' &&
            canStaff('products') &&
            resource.data.type == 'product'));
    }
  }
}
